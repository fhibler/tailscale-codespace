{
    "tailscale_on_ubuntu": {
        "image": "ubuntu:latest",
        "features": {
            "tailscale": {}
        }
    },
    "tailscale_on_alma": {
        "image": "almalinux:latest",
        "features": {
            "tailscale": {}
        }
    },
    "tailscale_version": {
        "image": "ubuntu:latest",
        "features": {
            "tailscale": {
                "version": "1.80.2"
            }
        }
    },
    "tailscale_auth_key": {
        "image": "ubuntu:latest",
        "containerEnv": {
            "TS_AUTH_KEY": "test-auth-key"
        },
        "features": {
            "tailscale": {}
        }
    },
    "tailscale_exit_node": {
        "image": "ubuntu:latest",
        "containerEnv": {
            "TS_AUTH_KEY": "test-auth-key",
            "TS_EXIT_NODE": "test-exit-node"
        },
        "features": {
            "tailscale": {}
        }
    },
    "tailscale_enforce": {
        "image": "ubuntu:latest",
        "containerEnv": {
            "TS_ENFORCE": "1"
        },
        "features": {
            "ghcr.io/devcontainers/features/common-utils:2": {
                "installZsh": true
            },
            "tailscale": {}
        }
    }
}